#!/bin/bash
# ClawFix - Quick Gateway Repair Tool
# For OpenClaw (formerly Clawdbot) on macOS
# Free version - manual fix only

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

GATEWAY_PORT=18789
MAX_SESSIONS=50

echo -e "${RED}"
echo "   ____ _              _____ _      "
echo "  / ___| | __ ___    __|  ___(_)_  __"
echo " | |   | |/ _` \ \ /\ / /| |_  | \ \/ /"
echo " | |___| | (_| |\ V  V / |  _| | |>  < "
echo "  \____|_|\__,_| \_/\_/  |_|   |_/_/\_\\"
echo -e "${CYAN}     Keeps Your Claws Up & Running ${NC}"
echo ""

issues_found=0
issues_fixed=0

# Check 1: Gateway process
echo -n "Checking gateway process... "
if pgrep -f "openclaw.*gateway\|clawdbot.*gateway" > /dev/null 2>&1; then
    echo -e "${GREEN}Running${NC}"
else
    echo -e "${RED}Not running${NC}"
    issues_found=$((issues_found + 1))
    echo -n "  Restarting... "
    if command -v openclaw &> /dev/null; then
        openclaw gateway restart 2>/dev/null && echo -e "${GREEN}Fixed${NC}" && issues_fixed=$((issues_fixed + 1)) || echo -e "${RED}Failed${NC}"
    elif command -v clawdbot &> /dev/null; then
        clawdbot gateway restart 2>/dev/null && echo -e "${GREEN}Fixed${NC}" && issues_fixed=$((issues_fixed + 1)) || echo -e "${RED}Failed${NC}"
    else
        echo -e "${RED}No openclaw/clawdbot found${NC}"
    fi
fi

# Check 2: Port
echo -n "Checking port $GATEWAY_PORT... "
if lsof -i :$GATEWAY_PORT > /dev/null 2>&1; then
    echo -e "${GREEN}Listening${NC}"
else
    echo -e "${YELLOW}Not listening${NC}"
fi

# Check 3: Sessions
state_dir="${CLAWDBOT_STATE_DIR:-$HOME/.clawdbot}"
sessions=0
if [ -d "$state_dir/sessions" ]; then
    sessions=$(find "$state_dir/sessions" -type f 2>/dev/null | wc -l | tr -d ' ')
fi
echo -n "Checking sessions ($sessions)... "
if [ "$sessions" -lt "$MAX_SESSIONS" ]; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${YELLOW}High - clearing${NC}"
    rm -rf "$state_dir/sessions"/* 2>/dev/null
    issues_fixed=$((issues_fixed + 1))
fi

# Check 4: Context overflow
echo -n "Checking context overflow... "
overflow_detected=0
if [ -f "$state_dir/logs/gateway.log" ]; then
    if tail -50 "$state_dir/logs/gateway.log" 2>/dev/null | grep -q "context limit\|exceed.*context\|max_tokens"; then
        overflow_detected=1
    fi
fi
if [ $overflow_detected -eq 1 ]; then
    echo -e "${RED}Token limit exceeded${NC}"
    issues_found=$((issues_found + 1))
    echo -n "  Clearing history... "
    rm -rf "$state_dir/history"/* 2>/dev/null
    echo -e "${GREEN}Cleared${NC}"
    issues_fixed=$((issues_fixed + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# Check 5: Security
echo -n "Checking security... "
if lsof -i :$GATEWAY_PORT 2>/dev/null | grep -q "\*:$GATEWAY_PORT\|0.0.0.0:$GATEWAY_PORT"; then
    echo -e "${YELLOW}Network exposed - bind to localhost!${NC}"
else
    echo -e "${GREEN}Local only${NC}"
fi

echo ""
if [ $issues_found -eq 0 ]; then
    echo -e "${GREEN}All checks passed!${NC}"
else
    echo -e "${GREEN}Fixed $issues_fixed of $issues_found issues${NC}"
fi

echo ""
echo -e "${CYAN}Want auto-monitoring? Get ClawFix Pro:${NC}"
echo -e "  https://bit.ly/clawfix-pro"
